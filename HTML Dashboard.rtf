<script>\
// =============================================\
// CONFIG \'97 replace with your Supabase details\
// =============================================\
const SUPABASE_URL = 'https://zbhndqojgkyzakgikjos.supabase.co/rest/v1/';\
const SUPABASE_ANON_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InpiaG5kcW9qZ2t5emFrZ2lram9zIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODA1Nzk0MDQsImV4cCI6MjA5NjE1NTQwNH0.mzeMfSI_dgZZzFQGVlxQxOV53hN7nbYM6dy_yIOfxIs';\
// =============================================\
\
const \{ createClient \} = supabase;\
const sb = createClient(SUPABASE_URL, SUPABASE_ANON_KEY);\
\
let players = [];\
let readiness = [];\
let activeFilter = 'all';\
let newAvatarData = null;\
\
// \uc0\u9472 \u9472  INIT \u9472 \u9472 \
document.getElementById('header-date').textContent =\
  new Date().toLocaleDateString('en-GB', \{ weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' \});\
\
async function loadDashboard() \{\
  document.getElementById('grid-area').innerHTML =\
    '<div class="loading"><div class="spinner"></div><p>Loading squad...</p></div>';\
\
  const today = new Date().toISOString().split('T')[0];\
\
  const [\{ data: pData \}, \{ data: rData \}] = await Promise.all([\
    sb.from('players').select('*').order('name'),\
    sb.from('readiness')\
      .select('*')\
      .gte('submitted_at', today + 'T00:00:00')\
      .lte('submitted_at', today + 'T23:59:59')\
  ]);\
\
  players = pData || [];\
  readiness = rData || [];\
\
  const responded = readiness.length;\
  const total = players.length;\
  document.getElementById('resp-count').textContent = `$\{responded\}/$\{total\} responses`;\
\
  updateZoneSummary();\
  renderGrid();\
\}\
\
function getReadiness(playerId) \{\
  return readiness.find(r => r.player_id === playerId) || null;\
\}\
\
function zoneOf(score) \{\
  if (score === null || score === undefined) return 'pending';\
  if (score >= 80) return 'attack';\
  if (score >= 50) return 'build';\
  return 'control';\
\}\
\
function barColor(v) \{\
  return v >= 8 ? '#22c55e' : v >= 5 ? '#f59e0b' : '#ef4444';\
\}\
\
function initials(name) \{\
  return name.split(' ').map(w => w[0]).join('').slice(0, 2).toUpperCase();\
\}\
\
function updateZoneSummary() \{\
  let a = 0, b = 0, c = 0;\
  players.forEach(p => \{\
    const r = getReadiness(p.id);\
    const z = zoneOf(r ? r.overall_score : null);\
    if (z === 'attack') a++;\
    else if (z === 'build') b++;\
    else if (z === 'control') c++;\
  \});\
  const total = players.length || 1;\
  document.getElementById('cnt-a').textContent = a;\
  document.getElementById('cnt-b').textContent = b;\
  document.getElementById('cnt-c').textContent = c;\
  document.getElementById('sub-a').textContent = `of $\{players.length\} players`;\
  document.getElementById('sub-b').textContent = `of $\{players.length\} players`;\
  document.getElementById('sub-c').textContent = `of $\{players.length\} players`;\
  document.getElementById('bar-a').style.width = Math.round(a / total * 100) + '%';\
  document.getElementById('bar-b').style.width = Math.round(b / total * 100) + '%';\
  document.getElementById('bar-c').style.width = Math.round(c / total * 100) + '%';\
\}\
\
function renderGrid() \{\
  const q = document.getElementById('search').value.toLowerCase();\
  let list = players.filter(p => p.name.toLowerCase().includes(q));\
\
  if (activeFilter === 'responded') list = list.filter(p => getReadiness(p.id));\
  else if (activeFilter === 'pending') list = list.filter(p => !getReadiness(p.id));\
  else if (activeFilter === 'flagged') list = list.filter(p => \{\
    const r = getReadiness(p.id);\
    return r && r.soreness_note;\
  \});\
\
  if (list.length === 0) \{\
    document.getElementById('grid-area').innerHTML =\
      '<p style="text-align:center;color:var(--muted);padding:40px;font-size:14px;">No players match this filter.</p>';\
    return;\
  \}\
\
  document.getElementById('grid-area').innerHTML =\
    '<div class="squad-grid">' + list.map(p => cardHTML(p)).join('') + '</div>';\
\}\
\
function cardHTML(p) \{\
  const r = getReadiness(p.id);\
  const score = r ? r.overall_score : null;\
  const av = p.image_url\
    ? `<img src="$\{p.image_url\}" alt="$\{p.name\}">`\
    : `<span>$\{initials(p.name)\}</span>`;\
  const scoreColor = score === null ? 'var(--muted)' : score >= 80 ? '#16a34a' : score >= 50 ? '#d97706' : '#dc2626';\
\
  const metricsHTML = r ? `\
    <div class="metrics-grid">\
      $\{[['Sleep quality', r.sleep_quality], ['Sleep duration', r.sleep_duration], ['Stress', r.stress], ['Soreness', r.soreness]].map(([l, v]) => `\
        <div class="m-cell">\
          <div class="m-label">$\{l\}</div>\
          <div class="m-val" style="color:$\{barColor(v)\};">$\{v\}<span style="font-size:10px;color:var(--muted);">/10</span></div>\
          <div class="m-bar"><div class="m-fill" style="width:$\{v * 10\}%;background:$\{barColor(v)\};"></div></div>\
        </div>`).join('')\}\
    </div>\
    $\{r.soreness_note ? `<div class="note-flag">\
      <svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/></svg>\
      <span>$\{r.soreness_note\}</span>\
    </div>` : ''\}\
  ` : `<div class="no-resp">\
    <svg viewBox="0 0 24 24"><path d="M12 2a10 10 0 1 0 0 20A10 10 0 0 0 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/></svg>\
    No response today\
  </div>`;\
\
  return `<div class="pcard">\
    <div class="pcard-top">\
      <div class="avatar">$\{av\}</div>\
      <div class="pinfo">\
        <div class="pname">$\{p.name\}</div>\
        <div class="ppos">$\{p.position || '\'97'\}</div>\
      </div>\
      <div class="ring-area" style="text-align:right;">\
        <div class="big-score" style="color:$\{scoreColor\};">$\{score !== null ? score : '\'97'\}</div>\
        <div class="score-label">score</div>\
      </div>\
    </div>\
    $\{metricsHTML\}\
  </div>`;\
\}\
\
function setFilter(f, btn) \{\
  activeFilter = f;\
  document.querySelectorAll('.fbtn').forEach(b => b.classList.remove('on'));\
  btn.classList.add('on');\
  renderGrid();\
\}\
\
// \uc0\u9472 \u9472  THEME \u9472 \u9472 \
function toggleTheme() \{\
  document.getElementById('theme-strip').classList.toggle('open');\
\}\
\
function applyTheme() \{\
  const c1 = document.getElementById('c1-pick').value;\
  const c2 = document.getElementById('c2-pick').value;\
  document.documentElement.style.setProperty('--club1', c1);\
  document.documentElement.style.setProperty('--club2', c2);\
  document.querySelector('.header').style.background = c1;\
  document.querySelector('.club-badge').style.background = c2;\
\}\
\
// \uc0\u9472 \u9472  ADD PLAYER \u9472 \u9472 \
function openAddModal() \{\
  document.getElementById('add-modal').classList.add('open');\
  document.getElementById('modal-err').textContent = '';\
  document.getElementById('new-name').value = '';\
  document.getElementById('new-pos').value = '';\
  document.getElementById('new-email').value = '';\
  document.getElementById('av-preview').innerHTML =\
    '<svg viewBox="0 0 24 24"><path d="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z"/></svg>';\
  newAvatarData = null;\
\}\
\
function closeModal() \{\
  document.getElementById('add-modal').classList.remove('open');\
\}\
\
function previewAvatar(input) \{\
  if (!input.files || !input.files[0]) return;\
  const reader = new FileReader();\
  reader.onload = e => \{\
    newAvatarData = e.target.result;\
    document.getElementById('av-preview').innerHTML =\
      `<img src="$\{newAvatarData\}" alt="preview">`;\
  \};\
  reader.readAsDataURL(input.files[0]);\
\}\
\
async function addPlayer() \{\
  if (players.length >= 50) \{\
    document.getElementById('modal-err').textContent = 'Squad limit of 50 players reached.';\
    return;\
  \}\
  const name = document.getElementById('new-name').value.trim();\
  const pos = document.getElementById('new-pos').value.trim();\
  const email = document.getElementById('new-email').value.trim();\
  if (!name) \{ document.getElementById('modal-err').textContent = 'Name is required.'; return; \}\
\
  let imageUrl = null;\
  if (newAvatarData) \{\
    const file = document.getElementById('av-file').files[0];\
    const ext = file.name.split('.').pop();\
    const path = `avatars/$\{Date.now()\}.$\{ext\}`;\
    const \{ data: upload, error: upErr \} = await sb.storage\
      .from('player-images')\
      .upload(path, file, \{ upsert: true \});\
    if (!upErr) \{\
      const \{ data: urlData \} = sb.storage.from('player-images').getPublicUrl(path);\
      imageUrl = urlData.publicUrl;\
    \}\
  \}\
\
  const \{ error \} = await sb.from('players').insert(\{ name, position: pos || null, image_url: imageUrl \});\
  if (error) \{ document.getElementById('modal-err').textContent = 'Error adding player. Please try again.'; return; \}\
\
  if (email) \{\
    await sb.auth.admin?.inviteUserByEmail?.(email).catch(() => \{\});\
  \}\
\
  closeModal();\
  loadDashboard();\
\}\
\
// \uc0\u9472 \u9472  REALTIME \u9472 \u9472 \
sb.channel('readiness-changes')\
  .on('postgres_changes', \{ event: 'INSERT', schema: 'public', table: 'readiness' \}, payload => \{\
    readiness.push(payload.new);\
    updateZoneSummary();\
    renderGrid();\
    const p = players.find(x => x.id === payload.new.player_id);\
    const responded = readiness.length;\
    document.getElementById('resp-count').textContent = `$\{responded\}/$\{players.length\} responses`;\
    if (p) console.log(`New submission from $\{p.name\}`);\
  \})\
  .subscribe();\
\
loadDashboard();\
</script>\
</body>\
</html>}